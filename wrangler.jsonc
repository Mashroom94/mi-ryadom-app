{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi-ryadom-app",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "keep_vars": true,
  "vars": {
    "VAPID_PUBLIC_KEY": "BMM9oSh3KOk-i4SfuWw7jYmNkw_2iHLLqNad5NUcOvC9Y5bJ6exIegzBbmorjbJY7Q_aIT2CP2mn2cDahjrjcMU"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mi-ryadom-db",
      "database_id": "afe647ae-3e49-4036-92fa-2e7da8410de3",
      "migrations_dir": "drizzle"
    }
  ]
}
